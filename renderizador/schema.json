{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lab365.senai/renderizador/schema/v2",
  "title": "Diagrama de Arquitetura AWS v2",
  "type": "object",
  "required": ["nome", "servicos"],
  "additionalProperties": true,
  "properties": {
    "versao":    { "type": "integer", "enum": [2] },
    "nome":      { "type": "string", "minLength": 1 },
    "subtitulo": { "type": "string" },
    "descricao": { "type": "string" },
    "regiao":    { "type": "string" },
    "padrao":    { "type": "string" },

    "servicos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "nome"],
        "additionalProperties": true,
        "properties": {
          "id":       { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "nome":     { "type": "string", "minLength": 1 },
          "tipo":     { "type": "string" },
          "icone":    { "type": "string" },
          "descricao":{ "type": "string" },
          "sublabel": { "type": "string" },
          "col":      { "type": "integer", "minimum": 0 },
          "row":      { "type": "integer", "minimum": 0 }
        }
      }
    },

    "grupos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nome"],
        "additionalProperties": true,
        "properties": {
          "id":       { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "nome":     { "type": "string", "minLength": 1 },
          "tipo": {
            "type": "string",
            "enum": ["aws-cloud", "aws-region", "generico"]
          },
          "servicos": {
            "type": "array",
            "items": { "type": "string" }
          },
          "filhos": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },

    "fluxo": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "de":        { "type": "string" },
          "para":      { "type": "string" },
          "passo":     { "type": "integer", "minimum": 1 },
          "rotulo":    { "type": "string" },
          "descricao": { "type": "string" },
          "estilo": {
            "type": "string",
            "enum": ["requisicao", "resposta", "assincrono", "tracejado"]
          },
          "rota": {
            "type": "string",
            "enum": ["reta", "ortogonal", "curva"]
          }
        }
      }
    }
  }
}
